{
  "format": "pantherclaw.conformance/v1",
  "group": "wrappers",
  "description": "How a framework wrapper (LangChain/LangGraph, OpenAI Agents SDK, CrewAI, Vercel AI SDK, MCP TypeScript SDK) decides each call of a wrapped tool through the /sdk face: only allow lets the tool run, a hold is waited on and the identical call resubmitted, an identical call reuses the action id of an earlier one only while that call is unresolved, in flight or held (M14 D68), a call is decided on the arguments the tool's function receives and refused with arguments outside its schema (D69), and every other outcome returns a refusal to the model (or raises, with raise_on_refusal) without running the tool. The fake gateway answers each /sdk request with the case's next answer, rewritten for the PC-Action-Id it received: action_id and every occurrence of the file's action_id in the decoded action_ir are replaced, and action_hash becomes the SHA-256 of the rewritten action_ir when it was the SHA-256 of the original.",
  "source": "the framework wrappers' contract (M14 PN-016.3, HR-328, HR-329) over the /sdk face answers of sdk_face.json (internal/gateway/sdk), internal/actionir for hashes, internal/authority/finalize for the action token and internal/gen protojson for the waits",
  "connection": "payments",
  "tool": "create_refund",
  "sdk_tool": "mcp__payments__create_refund",
  "path": "/sdk/payments",
  "parameters": [
    "amount",
    "charge",
    "currency",
    "reason"
  ],
  "action_id": "01920000-0000-7000-8000-000000000004",
  "codes": {
    "<code>": "a deny answer with a code: that code, verbatim (GRANT_AMOUNT_EXCEEDED, unknown_tool, use_gateway_face, duplicate_action, …)",
    "cannot_decide": "any other cannot_decide answer of the client (a gateway error, an answer that fails its checks)",
    "denied": "a deny answer without a code",
    "dispatch_required": "an allow carrying a request to send, with no on_dispatch handler",
    "hold_declined": "a hold that ended without an allow: declined or expired in PantherClaw, or its resubmission denied (except duplicate_action, reported verbatim; M14 D79)",
    "hold_timeout": "a hold not allowed within the wait: the client's resume answered cannot_decide",
    "undecided_args": "an argument outside the tool's schema (after alias normalisation), which PantherClaw would not decide (M14 D69)",
    "wrapper_error": "an exception inside the wrapper, or input that is not an object"
  },
