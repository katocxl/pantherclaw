# Build context of gateway.Dockerfile (BuildKit reads <Dockerfile>.dockerignore).
# Nothing secret and nothing only tests need goes into the build stage.
.git
.claude
**/node_modules
bin
dist
deploy/dev/secrets/
**/secrets/
**/.env
**/.env.*
**/*.pw
**/*.pem
**/*.key
**/testdata/
