// SPDX-License-Identifier: Apache-2.0
rule pc_siem_002_incident_opened {
  meta:
    author = "PantherClaw"
    description = "PantherClaw incident opened"
    severity = "High"
    rule_id = "pc-siem-002"

  events:
    $e.metadata.vendor_name = "PantherClaw"
    $e.additional.fields["ocsf_class_uid"] = "2005"
    $e.additional.fields["ocsf_activity_id"] = "1"
    $e.additional.fields["ocsf_test"] != "true"

  condition:
    $e
}
