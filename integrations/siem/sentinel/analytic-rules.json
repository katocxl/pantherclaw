{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "apiVersion": "2023-02-01",
      "kind": "Scheduled",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/0192f944-0000-7000-8000-000000000001')]",
      "properties": {
        "description": "A detection rule raised a HIGH or CRITICAL alert. How the alert knows what it says is in unmapped.pantherclaw_uncertainty: read it before you act.",
        "displayName": "PantherClaw high or critical alert",
        "enabled": false,
        "query": "PantherClawOCSF_CL\n| where toint(Ocsf.class_uid) == 2004 and toint(Ocsf.activity_id) == 1 and toint(Ocsf.severity_id) in (4, 5)\n| where not(Ocsf.metadata.labels has \"test\")",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT6M",
        "severity": "High",
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [],
        "techniques": [],
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0
      },
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules"
    },
    {
      "apiVersion": "2023-02-01",
      "kind": "Scheduled",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/0192f944-0000-7000-8000-000000000002')]",
      "properties": {
        "description": "An incident was opened or reopened.",
        "displayName": "PantherClaw incident opened",
        "enabled": false,
        "query": "PantherClawOCSF_CL\n| where toint(Ocsf.class_uid) == 2005 and toint(Ocsf.activity_id) == 1\n| where not(Ocsf.metadata.labels has \"test\")",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT6M",
        "severity": "High",
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [],
        "techniques": [],
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0
      },
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules"
    },
    {
      "apiVersion": "2023-02-01",
      "kind": "Scheduled",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/0192f944-0000-7000-8000-000000000003')]",
      "properties": {
        "description": "PantherClaw denied an action or could not authorize it. One denial is the product working; a run of them from one agent is worth a look.",
        "displayName": "PantherClaw denied an agent action",
        "enabled": false,
        "query": "PantherClawOCSF_CL\n| where toint(Ocsf.class_uid) == 6003 and tostring(Ocsf.metadata.event_code) == \"receipt.decision\" and toint(Ocsf.status_id) == 2\n| where not(Ocsf.metadata.labels has \"test\")",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT6M",
        "severity": "Low",
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [],
        "techniques": [],
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0
      },
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules"
    },
    {
      "apiVersion": "2023-02-01",
      "kind": "Scheduled",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/0192f944-0000-7000-8000-000000000004')]",
      "properties": {
        "description": "A coverage record for an agent or connection was invalidated, so what used to be enforced may no longer be.",
        "displayName": "PantherClaw enforcement coverage invalidated",
        "enabled": false,
        "query": "PantherClawOCSF_CL\n| where tostring(Ocsf.metadata.event_code) == \"coverage.invalidation\"\n| where not(Ocsf.metadata.labels has \"test\")",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT6M",
        "severity": "Medium",
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [],
        "techniques": [],
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0
      },
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules"
    },
    {
      "apiVersion": "2023-02-01",
      "kind": "Scheduled",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/0192f944-0000-7000-8000-000000000005')]",
      "properties": {
        "description": "A containment control was applied, a run was terminated or a credential was revoked.",
        "displayName": "PantherClaw containment action",
        "enabled": false,
        "query": "PantherClawOCSF_CL\n| where tostring(Ocsf.metadata.event_code) in (\"audit.response.contain\", \"audit.response.run_terminated\", \"audit.response.credential_revoked\")\n| where not(Ocsf.metadata.labels has \"test\")",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT6M",
        "severity": "Medium",
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [],
        "techniques": [],
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0
      },
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules"
    },
    {
      "apiVersion": "2023-02-01",
      "kind": "Scheduled",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/0192f944-0000-7000-8000-000000000006')]",
      "properties": {
        "description": "A person engaged the organization's kill switch.",
        "displayName": "PantherClaw kill switch engaged",
        "enabled": false,
        "query": "PantherClawOCSF_CL\n| where tostring(Ocsf.metadata.event_code) == \"audit.security.kill_switch_engaged\"\n| where not(Ocsf.metadata.labels has \"test\")",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT6M",
        "severity": "High",
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [],
        "techniques": [],
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0
      },
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules"
    },
    {
      "apiVersion": "2023-02-01",
      "kind": "Scheduled",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/0192f944-0000-7000-8000-000000000007')]",
      "properties": {
        "description": "A SIEM export destination was created, activated, paused, disabled or had its secret rotated. A paused export is a blind spot in this very SIEM.",
        "displayName": "PantherClaw SIEM export changed",
        "enabled": false,
        "query": "PantherClawOCSF_CL\n| where tostring(Ocsf.metadata.event_code) startswith \"audit.siem.destination_\"\n| where not(Ocsf.metadata.labels has \"test\")",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT6M",
        "severity": "Medium",
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [],
        "techniques": [],
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0
      },
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules"
    },
    {
      "apiVersion": "2023-02-01",
      "kind": "Scheduled",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/0192f944-0000-7000-8000-000000000008')]",
      "properties": {
        "description": "PantherClaw found an agent nobody has enrolled.",
        "displayName": "PantherClaw discovered an unclaimed agent",
        "enabled": false,
        "query": "PantherClawOCSF_CL\n| where tostring(Ocsf.metadata.event_code) == \"audit.agent.discovered\"\n| where not(Ocsf.metadata.labels has \"test\")",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT6M",
        "severity": "Low",
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [],
        "techniques": [],
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0
      },
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules"
    }
  ]
}
