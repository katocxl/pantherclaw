{
  "rules": [
    {
      "id": "rs-rows", "per": "agent", "kind": "CONSTRAIN",
      "summary": "the research agent reads at most 100 rows at a time",
      "operations": ["postgres.rows.read"], "when": "run.agent_id == {{agent}}", "reason": "RESEARCH_ROWS",
      "constraint": {"kind": "count_max", "param": "limit", "max": "100"}
    },
    {
      "id": "rs-classes", "per": "agent", "kind": "CONSTRAIN",
      "summary": "the research agent reads only public and internal columns: pii and secret values are withheld",
      "operations": ["postgres.rows.read"], "when": "run.agent_id == {{agent}}", "reason": "RESEARCH_CLASSES",
      "constraint": {"kind": "data_classes", "values": ["public", "internal"]}
    },
    {
      "id": "rs-channels", "per": "agent", "kind": "FORBID",
      "summary": "the research agent posts only to the Slack channels named with --slack-channel",
      "operations": ["slack.message.post"], "when": "run.agent_id == {{agent}} && !(action.target.id in {{slack_channels}})", "reason": "SLACK_CHANNEL_NOT_ALLOWED"
    },
    {
      "id": "rs-external", "per": "agent", "kind": "FORBID",
      "summary": "the research agent never posts to a Slack channel shared outside the organization",
      "operations": ["slack.message.disclose"], "when": "run.agent_id == {{agent}}", "reason": "EXTERNAL_DISCLOSURE"
    },
    {
      "id": "rs-public-pull", "per": "repo", "kind": "REQUIRE_APPROVAL",
      "summary": "an independent approver reads every pull request opened on the repository through a public destination before it is sent",
      "operations": ["github.pull.create"], "when": "{{repository}} && action.destination_class == 'public'", "reason": "PUBLIC_DISCLOSURE_NEEDS_APPROVAL",
      "approval": {"role": "approver", "count": 1, "independent": true}
    }
  ]
}
