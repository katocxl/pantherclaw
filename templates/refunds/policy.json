{
  "rules": [
    {
      "id": "refunds-cap", "per": "org", "kind": "CONSTRAIN",
      "summary": "no single refund above 500.00 USD",
      "operations": ["payments.refund.create"], "when": "true", "reason": "REFUND_OVER_CAP",
      "constraint": {"kind": "amount_max", "param": "amount", "max": "500.00", "currency": "USD"}
    },
    {
      "id": "refunds-hold", "per": "org", "kind": "REQUIRE_APPROVAL",
      "summary": "an independent approver approves every refund above 100.00 USD",
      "operations": ["payments.refund.create"], "when": "action.params.amount > money('100.00', 'USD')", "reason": "REFUND_NEEDS_APPROVAL",
      "approval": {"role": "approver", "count": 1, "independent": true}
    }
  ]
}
