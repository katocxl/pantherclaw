{
  "bounds": {
    "operations": ["stripe.refund.create", "stripe.refund.read", "stripe.payment_intent.read", "postgres.rows.read", "postgres.tables.read"],
    "targets": {
      "stripe.payment": {"prefixes": ["pi_", "ch_"]},
      "stripe.refund": {"prefixes": ["re_"]},
      "stripe.payment_intent": {"prefixes": ["pi_"]},
      "pg_table": {"ids": ["support.tickets", "shop.customers", "shop.orders"]}
    },
    "scope": {
      "postgres.rows.read": {
        "records": {"key": "customer", "values": ["{{customer}}"]},
        "classes": {"ids": ["public", "internal"]}
      }
    }
  },
  "limits": {
    "budgets": [{"id": "weekly_refunds", "grouping": "task", "operations": ["stripe.refund.create"], "currency": "USD", "limit": "500.00", "period": "week"}]
  }
}
